# Copy this file to .env and fill in the values before running the server.
# Never commit .env to version control — it is gitignored.

# The origin your React frontend runs on (used for CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Admin credentials for the /api/auth/login endpoint.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Application environment (development | production)
APP_ENV=development
